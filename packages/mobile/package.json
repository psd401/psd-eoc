{
  "name": "@psd-eoc/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "psdEocReleasePolicy": {
    "otaAllowedChangeKinds": [
      "copy-layout-style",
      "javascript-bugfix-existing-contract"
    ],
    "storeBuildRequiredChangeKinds": [
      "push",
      "auth",
      "native",
      "runtime",
      "persistent-data-shape",
      "start-event",
      "human-only-action",
      "real-drill-classification",
      "live-provider-gate"
    ],
    "otaRequiresDedicatedVerificationChannel": true,
    "otaVerificationBuildProfile": "ota-preview",
    "otaVerificationChannel": "ota-verification",
    "otaPublishEnvironment": "production",
    "safetyPathStoreBuildRequiresNewAppVersion": true,
    "storeSubmissionRequiresHumanApproval": true
  },
  "scripts": {
    "start": "expo start",
    "ios": "bun run prebuild:check && expo run:ios",
    "android": "bun run prebuild:check && expo run:android",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun run test:bun && bun run test:native",
    "test:bun": "bun test && bun run native-config:check",
    "test:native": "jest --config jest.config.cjs --runInBand",
    "native-config:check": "bun scripts/verify-event-room-native-config.ts && bun scripts/verify-push-native-config.ts",
    "native-config:push:check": "bun scripts/verify-push-native-config.ts",
    "expo:check": "expo install --check",
    "react:check": "bun scripts/verify-react-runtime.ts",
    "prebuild:check": "expo prebuild --no-install && prettier --write --ignore-path .prettier-native-ignore \"ios/**/*.json\""
  },
  "dependencies": {
    "@psd-eoc/contracts": "workspace:*",
    "expo": "~57.0.12",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.9",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4"
  }
}
