{
  "expo": {
    "name": "PSD EOC",
    "slug": "psd-eoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "psdeoc",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.psd401.eoc",
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "net.psd401.eoc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17324d"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#17324d"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#17324d",
          "defaultChannel": "eoc-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
