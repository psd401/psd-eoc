{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Retained least-privilege operations policy for the protected PSD EOC deployment role",
  "Resources": {
    "SesReadbackPolicy": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "ses:GetConfigurationSet",
                "ses:GetConfigurationSetEventDestinations"
              ],
              "Effect": "Allow",
              "Resource": "arn:aws:ses:us-west-2:<aws-account-id>:configuration-set/psd-eoc-transactional",
              "Sid": "ReadCanonicalConfigurationSetOnly"
            },
            {
              "Action": [
                "apprunner:AssociateCustomDomain",
                "apprunner:DescribeCustomDomains",
                "apprunner:ListOperations"
              ],
              "Effect": "Allow",
              "Resource": "arn:aws:apprunner:us-west-2:<aws-account-id>:service/psd-eoc/596fe233dacc4b0a816a890e44af4f59",
              "Sid": "ReadAndAssociateCanonicalCustomDomainOnly"
            },
            {
              "Action": "ecs:RunTask",
              "Condition": {
                "ArnEquals": {
                  "ecs:cluster": "arn:aws:ecs:us-west-2:<aws-account-id>:cluster/psd-eoc-bootstrap"
                }
              },
              "Effect": "Allow",
              "Resource": "arn:aws:ecs:us-west-2:<aws-account-id>:task-definition/psd-eoc-access-sync:*",
              "Sid": "RunCanonicalAccessSyncTaskOnCanonicalClusterOnly"
            },
            {
              "Action": "iam:PassRole",
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
              },
              "Effect": "Allow",
              "Resource": [
                "arn:aws:iam::<aws-account-id>:role/PsdEoc-AccessSyncTaskExecutionRole*",
                "arn:aws:iam::<aws-account-id>:role/PsdEoc-AccessSyncTaskRole*"
              ],
              "Sid": "PassCanonicalAccessSyncRolesToEcsTasksOnly"
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "psd-eoc-ses-readback",
        "Roles": ["psd-eoc-github-deploy"]
      },
      "Type": "AWS::IAM::Policy",
      "UpdateReplacePolicy": "Retain"
    }
  }
}
